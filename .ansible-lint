---

quiet: true
# Binary asset; ansible-lint tries to decode it as UTF-8 and warns.
exclude_paths:
  - templates/windows_templates/PolicyDefinitions.zip
skip_list:
  - 'package-latest'
  - 'risky-shell-pipe'
  # The one-file-per-control-band layout puts 138 tasks in WN19-00-xxxxxx.yml and 140 in
  # WN19-AU-xxxxxx.yml, over the rule's hard-coded 100. The limit is not configurable:
  # max_tasks is a runtime option that the config-file schema rejects, and there is no CLI
  # flag. Splitting the bands is the only way to satisfy the rule and would break the naming
  # convention shared with the sibling Windows roles.
  # NOTE: this disables the rule repo-wide, so a new file crossing 100 tasks is not reported.
  - 'complexity'
use_default_rules: true
verbosity: 0
